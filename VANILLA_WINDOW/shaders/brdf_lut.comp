#version 460

// Split-sum BRDF LUT (Karis 2013): x = NdotV, y = perceptual roughness -> (scale, bias) on F0.
// Built once.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D brdfLutImage;

const float PI = 3.14159265358979;
const uint  LUT_SIZE = 128u;
const uint  SAMPLE_COUNT = 512u;

vec2 hammersley(uint i, uint n) {
    uint bits = i;
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return vec2(float(i) / float(n), float(bits) * 2.3283064365386963e-10);
}

// Height-correlated Smith visibility, same as sceneshader.frag
float visibilitySmithGGX(float NdotL, float NdotV, float alpha) {
    float a2 = alpha * alpha;
    float gv = NdotL * sqrt(NdotV * NdotV * (1.0 - a2) + a2);
    float gl = NdotV * sqrt(NdotL * NdotL * (1.0 - a2) + a2);
    return 0.5 / max(gv + gl, 1e-6);
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= LUT_SIZE || id.y >= LUT_SIZE) { return; }

    float NdotV     = max((float(id.x) + 0.5) / float(LUT_SIZE), 1e-3);
    float roughness = max((float(id.y) + 0.5) / float(LUT_SIZE), 0.045);
    float alpha     = roughness * roughness;

    vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
    float A = 0.0, B = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; i++) {
        vec2  xi       = hammersley(i, SAMPLE_COUNT);
        float phi      = 2.0 * PI * xi.x;
        float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        vec3  H        = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
        vec3  L        = 2.0 * dot(V, H) * H - V;

        float NdotL = max(L.z, 0.0);
        float NdotH = max(H.z, 0.0);
        float VdotH = max(dot(V, H), 0.0);

        if (NdotL > 0.0) {
            // pdf = D * NdotH / (4 VdotH)  ->  BRDF * NdotL / pdf = Vis * 4 * VdotH * NdotL / NdotH
            float Gv = visibilitySmithGGX(NdotL, NdotV, alpha) * 4.0 * VdotH * NdotL / max(NdotH, 1e-6);
            float Fc = pow(1.0 - VdotH, 5.0);
            A += (1.0 - Fc) * Gv;
            B += Fc * Gv;
        }
    }

    imageStore(brdfLutImage, ivec2(id), vec4(A, B, 0.0, 0.0) / float(SAMPLE_COUNT));
}
