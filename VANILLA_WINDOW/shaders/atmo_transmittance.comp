#version 460
#extension GL_GOOGLE_include_directive : require

// Transmittance LUT: light reaching a point from the top of the atmosphere, per (height, zenith).
// Rebuilt only when the atmosphere parameters change.

#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer AtmosphereBuffer { AtmosphereParams atmo; };
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D transmittanceImage;

const float SAMPLE_COUNT = 40.0;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= TRANSMITTANCE_LUT_W || texel.y >= TRANSMITTANCE_LUT_H) { return; }

    vec2 uv = (vec2(texel) + 0.5) / vec2(TRANSMITTANCE_LUT_W, TRANSMITTANCE_LUT_H);

    float viewHeight, viewZenithCos;
    transmittanceParams(atmo, uv, viewHeight, viewZenithCos);

    vec3 pos = vec3(0.0, viewHeight, 0.0);
    vec3 dir = vec3(sqrt(max(0.0, 1.0 - viewZenithCos * viewZenithCos)), viewZenithCos, 0.0);

    // Optical depth to the top boundary (the ground is ignored, Bruneton's parameterization)
    float tMax = raySphereNearest(pos, dir, atmo.topRadius);
    vec3 opticalDepth = vec3(0.0);

    if (tMax > 0.0) {
        float dt = tMax / SAMPLE_COUNT;
        for (float i = 0.0; i < SAMPLE_COUNT; i += 1.0) {
            vec3 p = pos + (i + 0.5) * dt * dir;
            opticalDepth += sampleMedium(atmo, p).extinction * dt;
        }
    }

    imageStore(transmittanceImage, texel, vec4(exp(-opticalDepth), 1.0));
}
