#version 460
#extension GL_GOOGLE_include_directive : require

// Aerial perspective froxels (Hillaire 2020): 32 x 32 screen cells x 32 depth slices.
// texel (x, y, s): rgb = light scattered in by the air between the camera and the end of slice s
// (scene light units: x sun illuminance x PI), a = mean transmittance over that distance.
// One thread per screen cell marches through the slices. Rebuilt when the camera or the sun moves.

#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer AtmosphereBuffer { AtmosphereParams atmo; };
layout(set = 0, binding = 4) uniform sampler2D transmittanceLut;
layout(set = 0, binding = 5) uniform sampler2D multiScatterLut;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image3D aerialImage;

// Camera basis: dir = forward + ndc.x * right + ndc.y * up (pre-scaled by tan(fov / 2)), like the sky pass.
layout(push_constant, std430) uniform AerialPush {
    vec4 forward;
    vec4 right;
    vec4 up;
} cam;

const int SUBSTEPS = 2;

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= AERIAL_SIZE || id.y >= AERIAL_SIZE) { return; }

    vec2 ndc = (vec2(id) + 0.5) / float(AERIAL_SIZE) * 2.0 - 1.0;
    vec3 dir = normalize(cam.forward.xyz + ndc.x * cam.right.xyz + ndc.y * cam.up.xyz);

    vec3  pos      = vec3(0.0, atmo.cameraHeight, 0.0);
    vec3  sunDir   = normalize(atmo.sunDirection);
    float cosTheta = dot(dir, sunDir);
    float phaseRay = rayleighPhase(cosTheta);
    float phaseMie = miePhase(atmo.mieAnisotropy, cosTheta);

    vec3 luminance  = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float tPrev = 0.0;

    for (int s = 0; s < AERIAL_SIZE; s++) {
        float sliceEnd = float(s + 1) / float(AERIAL_SIZE);
        float tEnd     = AERIAL_DISTANCE_KM * sliceEnd * sliceEnd;
        float dt       = (tEnd - tPrev) / float(SUBSTEPS);

        for (int k = 0; k < SUBSTEPS; k++) {
            float t = tPrev + (float(k) + 0.5) * dt;
            vec3  p = pos + t * dir;

            // Below the ground: no more air to scatter in (geometry hides it anyway)
            float height = length(p);
            if (height < atmo.bottomRadius) { break; }

            Medium m = sampleMedium(atmo, p);
            vec3 ext = max(m.extinction, vec3(1e-7));
            vec3 stepTransmittance = exp(-ext * dt);

            vec3  up           = p / height;
            float sunZenithCos = dot(sunDir, up);
            vec3  toSun        = texture(transmittanceLut, transmittanceUv(atmo, height, sunZenithCos)).rgb;
            float earthShadow  = raySphereNearest(p, sunDir, atmo.bottomRadius) >= 0.0 ? 0.0 : 1.0;
            vec3  multiScatter = texture(multiScatterLut, multiScatterUv(atmo, height, sunZenithCos)).rgb;

            vec3 S = earthShadow * toSun * (m.scatteringMie * phaseMie + m.scatteringRay * phaseRay)
                   + multiScatter * m.scattering;

            luminance  += throughput * (S - S * stepTransmittance) / ext;
            throughput *= stepTransmittance;
        }

        tPrev = tEnd;

        vec3  L = luminance * atmo.sunIlluminance * PI;   // same units as the sky pass / scene
        float T = dot(throughput, vec3(1.0 / 3.0));
        imageStore(aerialImage, ivec3(id, s), vec4(L, T));
    }
}
