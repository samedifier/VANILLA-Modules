#version 460

// VANILLA WINDOW internal Hi-Z: mip 0 of the occlusion pyramid (half resolution) from the scene depth.
// Each texel keeps the FARTHEST depth of the source pixels it covers (and of every MSAA sample), so a test
// against it can only keep too much, never cull something visible. Compiled twice: with -DMSAA for
// multisampled depth. Embedded (include/vanilla_window_cull_spv.h).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifdef MSAA
layout(set = 0, binding = 0) uniform sampler2DMS depthTexture;
#else
layout(set = 0, binding = 0) uniform sampler2D depthTexture;
#endif
layout(set = 0, binding = 1, r32f) uniform writeonly image2D hizMip;

layout(push_constant, std430) uniform HiZPush {
    ivec2 srcSize;
    ivec2 dstSize;
    int   samples;
} pc;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= pc.dstSize.x || id.y >= pc.dstSize.y) { return; }

    // 2x2 source pixels, 3 on the last row / column of an odd source.
    int extraX = (id.x == pc.dstSize.x - 1 && (pc.srcSize.x & 1) == 1) ? 1 : 0;
    int extraY = (id.y == pc.dstSize.y - 1 && (pc.srcSize.y & 1) == 1) ? 1 : 0;

    float farthest = 0.0;
    for (int dy = 0; dy < 2 + extraY; dy++) {
        for (int dx = 0; dx < 2 + extraX; dx++) {
            ivec2 s = min(id * 2 + ivec2(dx, dy), pc.srcSize - 1);
#ifdef MSAA
            for (int k = 0; k < pc.samples; k++) { farthest = max(farthest, texelFetch(depthTexture, s, k).r); }
#else
            farthest = max(farthest, texelFetch(depthTexture, s, 0).r);
#endif
        }
    }

    imageStore(hizMip, id, vec4(farthest));
}
